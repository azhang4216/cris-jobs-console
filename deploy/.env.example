# Copy to deploy/.env on the application host. Use your own domain and contact.
# This file contains deployment locations, not secret contents.
CONSOLE_DOMAIN=console.example.org
ACME_EMAIL=operator@example.org
DMASIF_IMAGE=dmasif-console:local
DMASIF_STATE_VOLUME=dmasif_console_state

# Relative file paths resolve from deploy/, the first Compose file's directory.
OPERATOR_CONFIG_FILE=./private/operator.yaml
WEBHOOK_SECRET_FILE=./private/webhook-secret
VIEWER_PASSWORD_FILE=./private/viewer-password
CLUSTER_SSH_KEY_FILE=./private/cluster-key
CLUSTER_KNOWN_HOSTS_FILE=./private/known-hosts

# Optional private-repository override:
# REPOSITORY_TOKEN_FILE=./private/repository-token

# Pin tested image digests for a deployed release; tags below are build defaults.
# PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:<verified-digest>
# CADDY_IMAGE=caddy:2-alpine@sha256:<verified-digest>
